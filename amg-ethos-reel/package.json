{
  "name": "amg-ethos-reel",
  "version": "1.0.0",
  "private": true,
  "description": "AMG Insurance Group x Ethos Life Insurance partnership announcement reel (1080x1920 MP4), built with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render AmgEthosReel out/AMG_x_Ethos_Reel.mp4",
    "render:silent": "remotion render AmgEthosReel out/AMG_x_Ethos_Reel_silent.mp4 --muted",
    "sound": "python3 tools/sound.py",
    "logos": "node tools/trace.cjs tools/amg-word-bw.png tools/amg-word.svg && node tools/trace.cjs tools/ethos-word-bw.png tools/ethos-word.svg && node tools/trace.cjs tools/ethos-mark-bw.png tools/ethos-mark.svg && node tools/build-logos.cjs",
    "still": "remotion still AmgEthosReel"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/react": "19.1.0",
    "potrace": "2.1.8",
    "typescript": "5.7.3"
  }
}
