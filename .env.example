# ── Supabase (per environment: staging + prod are separate projects) ─────────
# See docs/ops/environments.md for the full runbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — admin/migration tooling ONLY.
# Never import in client code; never use in tenant-facing request paths.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (migration tooling only)
SUPABASE_DB_URL=

# ── Background scan run-queue (queue-infra block) ────────────────────────────
# Server-only. Signs the short-lived per-run tenant JWTs the processor mints
# (ruling A1). This is the project's JWT secret (Supabase -> Settings -> API ->
# JWT Settings -> JWT Secret). PostgREST verifies the minted tokens against it.
SUPABASE_JWT_SECRET=

# Server-only. Shared secret the enqueue kick presents to, and the processor +
# sweeper endpoints verify (timing-safe). Generate a long random value
# (e.g. `openssl rand -hex 32`). NEVER logged. If unset, the endpoints refuse
# (503) and the kick is skipped -- the sweeper/cron is the backstop.
RUNS_PROCESSOR_SECRET=

# Optional. Base origin the enqueue action self-kicks. Defaults to the local dev
# server (http://127.0.0.1:$PORT) so the whole loop runs under `npm run dev`
# with no extra config. In hosted environments set it to the deployment origin.
# RUNS_PROCESSOR_URL=https://your-app.example

# ── Phase 1 keys (added when their modules build — leave unset for now) ──────
# ANTHROPIC_API_KEY=            # M1b/M8/M18 — content, plans, resource center
# CITATION_DATA_API_KEY=        # M3 visibility tracker (Profound-class provider)
# SOCIAL_POSTING_API_KEY=       # M11 (Ayrshare-class provider)
# HUMANIZER_API_KEY=            # M9 authenticity gate
# AI_DETECTION_API_KEY=         # M9 authenticity gate
# CLOUDFLARE_API_TOKEN=         # edge-worker auto-fix deploys (1.3)
