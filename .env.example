# ── Supabase (per environment: staging + prod are separate projects) ─────────
# See docs/ops/environments.md for the full runbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — admin/migration tooling ONLY.
# Never import in client code; never use in tenant-facing request paths.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (migration tooling only)
SUPABASE_DB_URL=

# ── Phase 1 keys (added when their modules build — leave unset for now) ──────
# ANTHROPIC_API_KEY=            # M1b/M8/M18 — content, plans, resource center
# CITATION_DATA_API_KEY=        # M3 visibility tracker (Profound-class provider)
# SOCIAL_POSTING_API_KEY=       # M11 (Ayrshare-class provider)
# HUMANIZER_API_KEY=            # M9 authenticity gate
# AI_DETECTION_API_KEY=         # M9 authenticity gate
# CLOUDFLARE_API_TOKEN=         # edge-worker auto-fix deploys (1.3)
